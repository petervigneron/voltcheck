# Copy to .env.local (gitignored). Without these the app serves the bundled
# JSON fallback (web/data/scraped-listings.json) — it never breaks.
# Read-only anon/publishable key ONLY — never the service key in the web app.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
