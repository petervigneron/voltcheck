# Copy to .env (gitignored). Without this file db-sync.mjs skips quietly and
# the nightly pipeline behaves exactly as before.
# Service/secret key — write access. Never ships to the web app or a commit.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-OR-SECRET-KEY
